# Kamui pepper service, development configuration. Copy to .env and fill in.
# No value in this file is a secret. Never commit a filled-in copy.

# HTTP
PORT=8787
# Origins allowed to call the service from a browser (the keychain origin). Comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# Where the key is: env (development) or kms (production, AWS KMS).
PEPPER_KEY_SOURCE=env
# With PEPPER_KEY_SOURCE=kms: the ARN of the HMAC_256 KMS key. PEPPER_KEY_CHECK is then
# mandatory and PEPPER_KEY_HEX must not be set. AWS credentials come from the role the
# service runs as. AWS_REGION defaults to the Region in the ARN.
KMS_KEY_ID=
AWS_REGION=

# The master key, 32 bytes as 64 hex characters. DEVELOPMENT ONLY (PEPPER_KEY_SOURCE=env):
# in production the key lives in AWS KMS and this variable must not exist (DESIGN.md,
# section 13).
# Generate a throwaway one with: openssl rand -hex 32
PEPPER_KEY_HEX=
# Label returned with every pepper. There is one key for the life of the system.
PEPPER_KEY_VERSION=1
# Optional in development, mandatory with kms: the key check value recorded when the key
# was created. The service refuses to start if the loaded key does not match.
# Print the value for a key with: bun run src/index.ts --print-key-check
PEPPER_KEY_CHECK=

# OAuth client ids accepted per issuer (plan D3: the keychain client and the
# override-recovery client). Comma separated. An issuer with no entry is refused.
GOOGLE_AUDIENCES=
APPLE_AUDIENCES=

# Require proof that the caller holds the device key bound into the token nonce.
REQUIRE_KEY_PROOF=true
# Oldest token accepted, in seconds since it was issued (`iat`).
MAX_TOKEN_AGE_SECONDS=600

# Rate limits (token buckets, in memory, per process).
RATE_IP_BURST=30
RATE_IP_PER_MINUTE=30
RATE_SUBJECT_BURST=10
RATE_SUBJECT_PER_HOUR=10

# Trust the X-Forwarded-For header for the client address. Only behind a proxy you control.
TRUST_PROXY=false
