# Copy to .env.local and fill in. Secrets only; .env.local is gitignored.
# Registry addresses live in deployments.env (committed), keyed per chain, written by `bun run deploy:registry`.
RPC_URL=https://...
# Kamui: optional. The chain's name (SN_SEPOLIA, SN_MAIN). When set, the api, rotator and watcher
# start without waiting for the RPC and check in the background that the node is on this chain
# (they stop if it is not). When empty they ask the node first, and fail to start if it is down.
CHAIN_ID=
# Deploys the registry, owns it, and pays for key rotations. Needs STRK.
OWNER_ADDRESS=0x...
OWNER_PRIVATE_KEY=0x...

# Recover API (bun run service:api)
PORT=3000
# Deploys social accounts through the UDC and relays recover. Needs STRK. Not the owner.
RELAYER_ADDRESS=0x...
RELAYER_PRIVATE_KEY=0x...
# The SNIP-36 prover that runs prove_jwt; recover carries its proof.
PROVER_URL=http://localhost:9900
# Sender of the virtual prove_jwt transaction. Not a security boundary, but keep the key private so nobody
# can take the account over or bump its nonce. Never fund it.
PROVER_ACCOUNT_ADDRESS=0x...
PROVER_ACCOUNT_PRIVATE_KEY=0x...

# OAuth client ids `bun run deploy:registry` seeds as recovery auds. Same values as the client's VITE_*_CLIENT_ID.
AUTHORIZED_GOOGLE_RECOVERY_CLIENT_ID=
AUTHORIZED_APPLE_RECOVERY_CLIENT_ID=

# Also read from deployments.env (committed): KAMUI_ACCOUNT_CLASS_HASH, PROVER_EXECUTOR_ADDRESS, <CHAIN>_REGISTRY_ADDRESS

# The rotator answers GET /health on ROTATOR_PORT; the api proxies it from ROTATOR_URL as /health/rotator.
ROTATOR_PORT=3001
ROTATOR_URL=http://localhost:3001

# Cap on relayer-paid social account deployments through POST /deploy. 0 disables the route (local-proving first logins then need the client deploy hook).
DEPLOYS_PER_HOUR=30

# Kamui: the pepper service. When set, /recover confirms the request's pepper with it (the request
# must carry keyProof) and /deploy is disabled. Required on mainnet. Without it, on a testnet, any
# pepper is accepted, including 0.
PEPPER_SERVICE_URL=

# Kamui: POST /sponsor, the paymaster stand-in. Budgets come from a JSON file (see
# sponsor-budgets.example.json and src/services/sponsor/budgets.ts). Without a file there is only
# the anonymous budget: SPONSORED_PER_HOUR transactions an hour, 120 by default on testnets and
# 0 (off) on mainnet. An app key in the file is a public identifier, not a secret.
SPONSOR_BUDGETS_FILE=
SPONSORED_PER_HOUR=

# Kamui: the session registry's SQLite file. Default: data/registry.sqlite (gitignored). It holds
# which sites each account connected to: keep it on a private volume.
REGISTRY_DB=
# DELETE (default, a rollback journal) or TRUNCATE on a network volume; WAL only on a local disk.
# On a network volume run exactly one api process against the file.
REGISTRY_JOURNAL_MODE=DELETE

# Kamui: attempts per minute, per client and for everyone, as route=perClient/global pairs.
# Defaults: recover=6/60,poll=120/6000,relay=10/120,deploy=6/60,sponsor=30/600,registry=60/1200
RATE_LIMITS=
# Kamui: how many of our own proxies sit in front of the api (the keychain's /api proxy, a load
# balancer). 0: the client is the socket's peer. N: the Nth entry from the right of
# X-Forwarded-For. Set it too high and clients can pick their own address.
# TRUST_PROXY=true (the pepper service's name for it) means 1 when TRUSTED_PROXY_HOPS is empty.
TRUSTED_PROXY_HOPS=

# Kamui: the prover handles one proof at a time. At most PROVER_QUEUE_MAX requests wait, for at
# most PROVER_QUEUE_WAIT_MS; beyond that the recovery job fails with PROVER_BUSY (503).
PROVER_CONCURRENCY=1
PROVER_QUEUE_MAX=4
PROVER_QUEUE_WAIT_MS=300000
PROVER_TIMEOUT_MS=600000
# Kamui: deadline for one RPC request.
RPC_TIMEOUT_MS=30000

# Kamui: GET /metrics (Prometheus text) is served on its own port, never the public one. Do not
# publish this port; 0 turns it off. To scrape through the public port instead, set METRICS_TOKEN:
# /metrics there then needs "Authorization: Bearer <token>". Without a token it answers 404.
METRICS_PORT=9464
METRICS_HOST=0.0.0.0
METRICS_TOKEN=

# Kamui: where signing keys are read from. Only "env" exists; see src/secrets.ts.
SECRET_SOURCE=env

# Kamui: the registry key watcher (bun run service:watcher, bun run watch:once). Needs RPC_URL and
# the registry address from deployments.env, and no key. Alerts are error-level log lines; they
# are also POSTed as JSON to this URL when set.
WATCHER_WEBHOOK_URL=
WATCHER_POLL_SECONDS=60

# Optional AVNU paymaster (Sepolia only). Empty keeps the development relayer in /sponsor.
# This is the SNIP-29 RPC endpoint, never exposed to the browser. API key stays server-side.
# Read PAYMASTER.md: the local fee ceiling is only a preflight check in this mode.
PAYMASTER_URL=
PAYMASTER_API_KEY=
# Used only by the optional compose.paymaster.yml overlay; supply an image pinned by digest
# and a private upstream profile prepared by the operator outside the repository.
PAYMASTER_IMAGE=
PAYMASTER_PROFILE_PATH=
