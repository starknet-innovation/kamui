[Unit]
Description=Fetch Kamui %i runtime files from AWS Secrets Manager
Wants=network-online.target
After=network-online.target
Before=kamui@%i.service

[Service]
# Runs on the host as root with the instance role; never inside a container.
Type=oneshot
ExecStart=/usr/bin/python3 /opt/kamui/lean/scripts/secrets-sync.py %i
TimeoutStartSec=120
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
