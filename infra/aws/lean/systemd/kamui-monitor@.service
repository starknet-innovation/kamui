[Unit]
Description=Kamui %i local health and disk probe
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
Environment=CONFIG_DIRECTORY=/etc/kamui
Environment=STATE_DIRECTORY=/var/lib/kamui
ExecStart=/usr/bin/python3 /opt/kamui/lean/scripts/monitor.py %i
# Operator must add an approved OnFailure unit/alert destination; no recipient is configured here.
