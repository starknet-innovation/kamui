{
  admin off
  # Default proxy error records can include complete headers/URI. Drop that logger.
  log default {
    exclude http.log.error
  }
  auto_https disable_redirects
  servers {
    timeouts {
      read_header 10s
    }
  }
}
http://{$KEYCHAIN_HOST} {
  respond "HTTPS required" 400
}
https://{$KEYCHAIN_HOST} {
  request_body {
    max_size 1MB
  }
  @private path /metrics /metrics/* /api/metrics /api/metrics/* /api/recover /api/deploy /api/health/rotator /api/health/prover
  respond @private "not found" 404
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy keychain:5173 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up -X-Forwarded-Host
    transport http {
      response_header_timeout 40s
    }
  }
}
