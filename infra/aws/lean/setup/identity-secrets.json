{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Operator-run Sepolia host identity and private backup repository. No signing key, pepper key mutation or hosted registry administration. Successor: adds this host's runtime secrets, their dedicated KMS key, and the one decrypt path the host needs.",
  "Parameters": {
    "HostRole": {
      "Type": "String",
      "AllowedValues": [
        "backend",
        "pepper"
      ]
    },
    "ExistingPepperKeyArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:kms:eu-west-1:[0-9]{12}:key/[a-zA-Z0-9-]+$",
      "Description": "Existing HMAC key only; required for pepper. Keep actual value private."
    },
    "BackupBucketName": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$",
      "Description": "Unique private dedicated repository bucket; required for backend."
    }
  },
  "Rules": {
    "BackendBucketRequired": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "HostRole"
          },
          "backend"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "BackupBucketName"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Backend requires a dedicated backup bucket name."
        }
      ]
    },
    "PepperKeyRequired": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "HostRole"
          },
          "pepper"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "ExistingPepperKeyArn"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Pepper requires its existing immutable HMAC key reference."
        }
      ]
    },
    "SepoliaRegion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "eu-west-1"
            ]
          },
          "AssertDescription": "This Sepolia package is fixed to eu-west-1."
        }
      ]
    }
  },
  "Conditions": {
    "IsBackend": {
      "Fn::Equals": [
        {
          "Ref": "HostRole"
        },
        "backend"
      ]
    }
  },
  "Resources": {
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "Condition": "IsBackend",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Ref": "BackupBucketName"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "kamui"
          },
          {
            "Key": "Network",
            "Value": "sepolia"
          },
          {
            "Key": "Role",
            "Value": {
              "Ref": "HostRole"
            }
          }
        ]
      }
    },
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Condition": "IsBackend",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "InstanceProfileName": {
          "Fn::Sub": "KamuiSepolia-${HostRole}-Host"
        },
        "Path": "/kamui/sepolia/hosts/",
        "Roles": [
          {
            "Ref": "HostIdentityRole"
          }
        ]
      }
    },
    "HostIdentityRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "KamuiSepolia-${HostRole}-Host"
        },
        "Path": "/kamui/sepolia/hosts/",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "KamuiSepoliaHostScope",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "NoIamOrRoleChaining",
                  "Effect": "Deny",
                  "Action": [
                    "iam:*",
                    "sts:AssumeRole",
                    "sts:AssumeRoleWithSAML",
                    "sts:AssumeRoleWithWebIdentity",
                    "sts:GetFederationToken",
                    "sts:GetSessionToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Fn::If": [
                    "IsBackend",
                    {
                      "Sid": "LocateOwnBackupBucket",
                      "Effect": "Allow",
                      "Action": [
                        "s3:GetBucketLocation"
                      ],
                      "Resource": {
                        "Fn::GetAtt": [
                          "BackupBucket",
                          "Arn"
                        ]
                      }
                    },
                    {
                      "Sid": "UseExistingPepperMacKey",
                      "Effect": "Allow",
                      "Action": [
                        "kms:GenerateMac",
                        "kms:VerifyMac",
                        "kms:DescribeKey"
                      ],
                      "Resource": {
                        "Ref": "ExistingPepperKeyArn"
                      }
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "IsBackend",
                    {
                      "Sid": "ListOnlyRepositoryPrefix",
                      "Effect": "Allow",
                      "Action": [
                        "s3:ListBucket"
                      ],
                      "Resource": {
                        "Fn::GetAtt": [
                          "BackupBucket",
                          "Arn"
                        ]
                      },
                      "Condition": {
                        "StringLike": {
                          "s3:prefix": [
                            "kamui-sepolia",
                            "kamui-sepolia/*"
                          ]
                        }
                      }
                    },
                    {
                      "Sid": "NoOtherKmsResource",
                      "Effect": "Deny",
                      "Action": "kms:*",
                      "NotResource": [
                        {
                          "Ref": "ExistingPepperKeyArn"
                        },
                        {
                          "Fn::GetAtt": [
                            "RuntimeSecretsKey",
                            "Arn"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "IsBackend",
                    {
                      "Sid": "InspectOwnMultipartUploads",
                      "Effect": "Allow",
                      "Action": [
                        "s3:ListBucketMultipartUploads"
                      ],
                      "Resource": {
                        "Fn::GetAtt": [
                          "BackupBucket",
                          "Arn"
                        ]
                      }
                    },
                    {
                      "Sid": "NoOtherOperationOnPepperKey",
                      "Effect": "Deny",
                      "NotAction": [
                        "kms:GenerateMac",
                        "kms:VerifyMac",
                        "kms:DescribeKey"
                      ],
                      "Resource": {
                        "Ref": "ExistingPepperKeyArn"
                      }
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "IsBackend",
                    {
                      "Sid": "MaintainOwnRepositoryObjects",
                      "Effect": "Allow",
                      "Action": [
                        "s3:GetObject",
                        "s3:PutObject",
                        "s3:DeleteObject",
                        "s3:AbortMultipartUpload",
                        "s3:ListMultipartUploadParts"
                      ],
                      "Resource": {
                        "Fn::Sub": "${BackupBucket.Arn}/kamui-sepolia/*"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "IsBackend",
                    {
                      "Sid": "NoKmsOnBackend",
                      "Effect": "Deny",
                      "Action": "kms:*",
                      "NotResource": {
                        "Fn::GetAtt": [
                          "RuntimeSecretsKey",
                          "Arn"
                        ]
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "IsBackend",
                    {
                      "Sid": "ReadOwnRuntimeSecrets",
                      "Effect": "Allow",
                      "Action": "secretsmanager:GetSecretValue",
                      "Resource": [
                        {
                          "Ref": "RuntimeSecret"
                        },
                        {
                          "Ref": "RelayerSecret"
                        }
                      ]
                    },
                    {
                      "Sid": "ReadOwnRuntimeSecrets",
                      "Effect": "Allow",
                      "Action": "secretsmanager:GetSecretValue",
                      "Resource": [
                        {
                          "Ref": "RuntimeSecret"
                        }
                      ]
                    }
                  ]
                },
                {
                  "Sid": "DecryptRuntimeSecretsThroughSecretsManager",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": {
                    "Fn::GetAtt": [
                      "RuntimeSecretsKey",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "secretsmanager.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                },
                {
                  "Sid": "OnlyDecryptOnRuntimeSecretsKey",
                  "Effect": "Deny",
                  "NotAction": "kms:Decrypt",
                  "Resource": {
                    "Fn::GetAtt": [
                      "RuntimeSecretsKey",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "RuntimeSecretsKeyOnlyThroughSecretsManager",
                  "Effect": "Deny",
                  "Action": "kms:Decrypt",
                  "Resource": {
                    "Fn::GetAtt": [
                      "RuntimeSecretsKey",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringNotEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "secretsmanager.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "MaxSessionDuration": 3600,
        "Tags": [
          {
            "Key": "Project",
            "Value": "kamui"
          },
          {
            "Key": "Network",
            "Value": "sepolia"
          },
          {
            "Key": "Role",
            "Value": {
              "Ref": "HostRole"
            }
          }
        ]
      }
    },
    "RuntimeSecretsKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": {
          "Fn::Sub": "Encrypts the Kamui Sepolia ${HostRole} host runtime secrets only."
        },
        "EnableKeyRotation": true,
        "KeySpec": "SYMMETRIC_DEFAULT",
        "KeyUsage": "ENCRYPT_DECRYPT",
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountAdministersThroughIam",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "RuntimeSecretsKeyAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": {
          "Fn::Sub": "alias/kamui-sepolia-${HostRole}-runtime-secrets"
        },
        "TargetKeyId": {
          "Ref": "RuntimeSecretsKey"
        }
      }
    },
    "RuntimeSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "kamui-sepolia/${HostRole}/runtime"
        },
        "Description": "Kamui runtime files for this host, as a hashed bundle. Value set by the operator step 13 only.",
        "KmsKeyId": {
          "Ref": "RuntimeSecretsKey"
        },
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "RuntimeSecretPolicy": {
      "Type": "AWS::SecretsManager::ResourcePolicy",
      "Properties": {
        "SecretId": {
          "Ref": "RuntimeSecret"
        },
        "BlockPublicPolicy": true,
        "ResourcePolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyThisHostReadsTheValue",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": "*",
              "Condition": {
                "StringNotEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "HostIdentityRole",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "RelayerSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "kamui-sepolia/backend/relayer-private-key",
        "Description": "Relayer signing key. Value set by the operator by hand; no Kamui tool reads or writes it.",
        "KmsKeyId": {
          "Ref": "RuntimeSecretsKey"
        },
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      },
      "Condition": "IsBackend"
    },
    "RelayerSecretPolicy": {
      "Type": "AWS::SecretsManager::ResourcePolicy",
      "Properties": {
        "SecretId": {
          "Ref": "RelayerSecret"
        },
        "BlockPublicPolicy": true,
        "ResourcePolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyThisHostReadsTheValue",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": "*",
              "Condition": {
                "StringNotEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "HostIdentityRole",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "Condition": "IsBackend"
    }
  },
  "Outputs": {
    "InstanceProfileName": {
      "Value": {
        "Ref": "InstanceProfile"
      }
    },
    "HostRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "HostIdentityRole",
          "Arn"
        ]
      }
    },
    "BackupBucketName": {
      "Condition": "IsBackend",
      "Value": {
        "Ref": "BackupBucket"
      }
    },
    "BackupRepositoryPrefix": {
      "Condition": "IsBackend",
      "Value": "kamui-sepolia/"
    },
    "RuntimeSecretArn": {
      "Value": {
        "Ref": "RuntimeSecret"
      }
    },
    "RuntimeSecretsKeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "RuntimeSecretsKey",
          "Arn"
        ]
      }
    },
    "RelayerSecretArn": {
      "Condition": "IsBackend",
      "Value": {
        "Ref": "RelayerSecret"
      }
    }
  },
  "Metadata": {
    "ValidationNotes": "W1030 is disabled for this template only because the backend-only empty ExistingPepperKeyArn is evaluated in unused pepper IAM branches. Nonempty key inputs have an ARN-shaped eu-west-1 AllowedPattern; PepperKeyRequired rejects empty key inputs for pepper. Other cfn-lint rules remain enabled.",
    "cfn-lint": {
      "config": {
        "ignore_checks": [
          "W1030"
        ]
      }
    }
  }
}
