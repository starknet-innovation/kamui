{
  // Type-checks every example the docs include, against the SDK source (not the built package).
  // Run from docs/: bun run typecheck
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "svelte"],
    "baseUrl": ".",
    "paths": {
      "@kamui/sdk": ["../../sdk/src/index.ts"],
      "@kamui/sdk/starknet-react": ["../../sdk/src/starknet-react.ts"],
      "@starknet-react/core": ["../../sdk/node_modules/@starknet-react/core"],
      "@starknet-react/chains": ["../../sdk/node_modules/@starknet-react/chains"],
      "starknet": ["../../sdk/node_modules/starknet"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
