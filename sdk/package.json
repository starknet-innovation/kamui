{
  "name": "@kamui/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for Kamui accounts: owners, sessions, spending limits and sponsored calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starknet-innovation/kamui.git",
    "directory": "sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./starknet-start": {
      "types": "./dist/starknet-start.d.ts",
      "default": "./dist/starknet-start.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:unit": "bun test test/unit.test.ts",
    "test:devnet": "bun test test/devnet.test.ts",
    "test:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@starknet-io/get-starknet-core": ">=6.0.0",
    "@starknetfoundation/starknet-start-react": ">=2.0.0",
    "react": ">=19.0.0",
    "starknet": "^10.8.0"
  },
  "peerDependenciesMeta": {
    "@starknet-io/get-starknet-core": {
      "optional": true
    },
    "@starknetfoundation/starknet-start-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@starknet-io/get-starknet-core": "6.1.0",
    "@starknet-io/get-starknet-modal": "6.1.0",
    "@starknet-io/get-starknet-wallet-standard": "6.1.1",
    "@starknetfoundation/starknet-start-chains": "1.0.13",
    "@starknetfoundation/starknet-start-providers": "1.1.4",
    "@starknetfoundation/starknet-start-react": "2.0.3",
    "@tanstack/react-query": "5.107.1",
    "@types/bun": "^1.1.0",
    "@types/react": "19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-test-renderer": "19.2.0",
    "starknet": "10.8.0",
    "typescript": "^5.6.0"
  }
}
