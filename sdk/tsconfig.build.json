{
  // Builds the published package: plain ESM and type declarations in dist/, from src/ only.
  // No Bun types here, so src/ cannot come to depend on a Bun-only API.
  //
  // Bundler resolution, not NodeNext: under NodeNext, eventemitter3's declarations resolve as
  // CommonJS and @starknet-react/core's Connector loses its emitter methods, so
  // src/starknet-react.ts does not compile. Bundler resolution does not insist on the ".js"
  // extension that plain Node needs on relative imports; scripts/check-package.mjs checks that
  // on the built files instead.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"]
}
