{
  // Builds the published package: plain ESM and type declarations in dist/, from src/ only.
  // NodeNext makes tsc reject a relative import without its ".js" extension, which plain Node
  // could not resolve. No Bun types here, so src/ cannot come to depend on a Bun-only API.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"]
}
